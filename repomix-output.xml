import { useEffect, useState } from 'react';
import { supabase, supabaseConfigured } from './supabase.js';
import React from 'react';
import PreferenceForm from './components/PreferenceForm';

const API_BASE = import.meta.env.VITE_API_BASE_URL ?? '';

export default function App() {
  const [session, setSession] = useState(null);
  const [email, setEmail] = useState('');
  const [message, setMessage] = useState('');
  const [loading, setLoading] = useState(false);
  const [apiStatus, setApiStatus] = useState('Checking API…');
  const [trips, setTrips] = useState([]);

  useEffect(() => {
    fetch(`${API_BASE}/api/health`)
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((data) => setApiStatus(`API online · ${data.environment}`))
      .catch(() => setApiStatus('API not reachable — start the backend'));
    if (!supabase) return;
    supabase.auth.getSession().then(({ data }) => setSession(data.session));
    const { data: listener } = supabase.auth.onAuthStateChange((_event, nextSession) => {
      setSession(nextSession);
    });
    return () => listener.subscription.unsubscribe();
  }, []);

  useEffect(() => {
    if (session && supabase) loadTrips();
    else setTrips([]);
  }, [session]);

  async function signIn(event) {
    event.preventDefault();
    if (!supabase) return;
    setLoading(true); setMessage('');
    const { error } = await supabase.auth.signInWithOtp({
      email: email.trim(),
      options: { emailRedirectTo: window.location.origin },
    });
    setMessage(error ? error.message : 'Check your email for the sign-in link.');
    setLoading(false);
  }

  async function signOut() {
    const { error } = await supabase.auth.signOut();
    setMessage(error ? error.message : 'Signed out.');
  }

  async function loadTrips() {
    const { data, error } = await supabase
      .from('trips')
      .select('id,title,destination_name,start_date,end_date,status,budget,currency')
      .order('start_date', { ascending: true })
      .limit(20);
    if (error) setMessage(`Could not load trips: ${error.message}`);
    else setTrips(data || []);
  }

  const handleFormSubmit = async (formData) => {
    setLoading(true);
    setMessage('');

    try {
      // 1. Call backend to generate the AI prompt (Activity 3.2)
      const promptRes = await fetch(`${API_BASE}/api/generate-prompt`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
      });

      if (!promptRes.ok) throw new Error('Failed to generate AI prompt.');
      const promptData = await promptRes.json();

      // 2. Map form options to fit the database constraints
      const budgetMapping = { Low: 500, Medium: 1500, High: 5000 };
      const numericBudget = budgetMapping[formData.budget] || 1500;

      // 3. Insert the trip directly into Supabase matching schema constraints
      if (supabase && session) {
        const { error: dbError } = await supabase.from('trips').insert([
          {
            user_id: session.user.id,
            title: `Trip to ${formData.destination}`,
            destination_name: formData.destination,
            start_date: formData.startDate,
            end_date: formData.endDate,
            budget: numericBudget,
            status: 'planned', // Must match the allowed check constraint ('draft','planned','completed','archived')
            currency: 'USD'
          }
        ]);

        if (dbError) {
          console.error('Database insertion error:', dbError.message);
          throw new Error(`Failed to save trip to database: ${dbError.message}`);
        }
      }

      setMessage('Preferences saved and AI prompt structured successfully!');
      loadTrips(); // Refresh the list of saved trips from Supabase
    } catch (error) {
      console.error(error);
      setMessage(error.message || 'Error processing your trip preferences with the backend.');
    } finally {
      setLoading(false);
    }
  };

  if (!supabaseConfigured) {
    return <main className="shell"><section className="hero"><p className="eyebrow">MILESTONE 2 · DATABASE SETUP</p><h1>WanderPlan</h1><p>Connect your Supabase project to activate authentication and trip storage.</p></section><section className="panel"><h2>Configuration required</h2><p>Copy <code>frontend/.env.example</code> to <code>frontend/.env</code> and set your Supabase URL and publishable key. Restart Vite after changing environment variables.</p></section></main>;
  }

  return (
    <main className="shell">
      <header className="topbar">
        <div className="brand"><span className="brand-icon">✦</span> WanderPlan</div>
        <span className="status"><i />{apiStatus}</span>
      </header>

      <section className="hero">
        <p className="eyebrow">YOUR NEXT ADVENTURE STARTS HERE</p>
        <h1>Travel plans that<br /><em>feel like you.</em></h1>
        <p className="hero-copy">Activity 3.1: User Preference Capture & Personalized Itinerary Builder.</p>
        <div className="chips"><span>✧ Your travel style</span><span>⌖ Curated destinations</span><span>◷ Day-by-day plans</span></div>
      </section>

      <section className="panel">
        {!session ? (
          <>
            <div className="panel-heading">
              <div><p className="eyebrow">GET STARTED</p><h2>Sign in to your planner</h2></div>
              <span className="lock">⌑</span>
            </div>
            <p className="muted">We’ll email you a secure sign-in link. No password required.</p>
            <form onSubmit={signIn} className="signin-form">
              <label htmlFor="email">Email address</label>
              <div className="input-row">
                <input 
                  id="email" 
                  type="email" 
                  required 
                  maxLength="254" 
                  autoComplete="email" 
                  placeholder="you@example.com" 
                  value={email} 
                  onChange={(e) => setEmail(e.target.value)} 
                />
                <button disabled={loading}>{loading ? 'Sending…' : 'Send sign-in link →'}</button>
              </div>
            </form>
          </>
        ) : (
          <>
            <div className="panel-heading">
              <div><p className="eyebrow">YOUR SPACE</p><h2>Plan Your Trip</h2></div>
              <button className="secondary" onClick={signOut}>Sign out</button>
            </div>
            <p className="muted mb-4">Signed in as {session.user.email}</p>
            
            {/* Activity 3.1 Preference Form Integration */}
            <div className="my-6">
              <PreferenceForm onSubmit={handleFormSubmit} />
            </div>

            <div className="mt-8">
              <h3 className="text-lg font-semibold mb-2">Your Saved Trips</h3>
              {trips.length ? (
                <div className="trip-list">
                  {trips.map((trip) => (
                    <article className="trip" key={trip.id}>
                      <div><strong>{trip.title}</strong><p>{trip.destination_name} · {trip.start_date} – {trip.end_date}</p></div>
                      <span className="trip-status">{trip.status}</span>
                    </article>
                  ))}
                </div>
              ) : (
                <div className="empty">
                  <span>✧</span>
                  <strong>Your journey begins here</strong>
                  <p>No saved trips yet. Submit your preferences above to create one.</p>
                </div>
              )}
            </div>
            <button className="secondary refresh mt-4" onClick={loadTrips}>Refresh trips ↻</button>
          </>
        )}
        {message && <p className="message" role="status">{message}</p>}
      </section>

      <footer>
        <span>WanderPlan · Milestone 3</span>
        <span>Built for journeys with intention.</span>
      </footer>
    </main>
  );
}
