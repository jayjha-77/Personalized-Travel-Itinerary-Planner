.trip-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.delete-button {
  background: #fff0ef;
  color: #b42318;
  border: 1px solid #f5c2be;
  padding: 0 14px;
  min-height: 34px;
  border-radius: 8px;
}

.delete-button:hover {
  background: #ffe1de;
}

.delete-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.trip-preferences {
  margin-top: 10px;
}

@media (max-width: 620px) {
  .trip-actions {
    flex-wrap: wrap;
  }
}

/* WanderPlan AI recommendation and itinerary views */
.preference-form{margin-top:18px;padding:24px;border:1px solid #e8e9e2;border-radius:18px;background:#fbfcf8;color:#17211d}
.preference-form h3,.results-section h3{font-size:22px;letter-spacing:-.03em;margin:0 0 8px}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:20px 0}
.form-grid label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:700}
.form-grid input,.form-grid select{width:100%;min-width:0;border:1px solid #dfe4da;border-radius:9px;padding:11px;background:white;color:#17211d;font:inherit;font-weight:400}
.interest-fieldset{border:1px solid #e1e7dc;border-radius:12px;padding:14px;margin:0 0 18px}
.interest-fieldset legend{font-size:12px;font-weight:700;padding:0 6px}
.interest-options{display:flex;flex-wrap:wrap;gap:9px}
.interest-option{display:flex;align-items:center;gap:6px;border:1px solid #dfe7db;background:#fff;border-radius:99px;padding:7px 10px;font-size:12px}
.interest-option input{accent-color:#315c42}
.results-section{margin-top:26px;padding-top:24px;border-top:1px solid #e9ede5}
.destination-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:18px 0}
.destination-card,.day-card{border:1px solid #e5e9e0;background:#fff;border-radius:15px;padding:18px;margin:12px 0}
.destination-card h4,.day-card h4{font-size:19px;margin:0 0 9px;letter-spacing:-.02em}
.destination-card p,.day-card p{font-size:13px;line-height:1.55}
.destination-card strong{font-size:12px;display:block;margin:12px 0;color:#315c42}
.destination-card button{width:100%;margin-top:8px}
.budget-summary{padding:16px;background:#f0f5ec;border-radius:12px;margin:16px 0}
.activity-list{display:flex;flex-direction:column;gap:0;margin-top:12px}
.activity-item{display:grid;grid-template-columns:110px minmax(0,1fr);gap:14px;padding:14px 0;border-top:1px solid #edf0e9}
.activity-time{font-size:12px;font-weight:700;color:#315c42;padding-top:2px}
.activity-item strong{font-size:14px}
.activity-item p{margin:5px 0}
@media(max-width:620px){.form-grid{grid-template-columns:1fr}.preference-form{padding:18px}.activity-item{grid-template-columns:1fr;gap:4px}.destination-grid{grid-template-columns:1fr}}
